# This repo is pinned to the GitHub account HowardZlh so that `gh` and
# `git push` never pick up another account logged into gh CLI.
#
# One-time setup on a new machine (the `.git/config` part does not travel
# with clone). Requires the `gh()` wrapper in ~/.zshenv that reads
# `git config gh.configDir`; see the gh-account-isolation skill.
#
#   # 1. dedicated gh config dir, reusing the already-logged-in token
#   mkdir -p ~/.config/gh-howardzlh
#   gh auth token -u HowardZlh | GH_CONFIG_DIR=~/.config/gh-howardzlh gh auth login --with-token
#
#   # 2. tell the gh wrapper which config dir this repo uses
#   git config --local gh.configDir '~/.config/gh-howardzlh'
#
#   # 3. pin git credentials (empty helper first clears osxkeychain)
#   git remote set-url origin https://HowardZlh@github.com/HowardZlh/Guushu.git
#   git config --local credential.helper ''
#   git config --local --add credential.helper '!GH_CONFIG_DIR=$HOME/.config/gh-howardzlh gh auth git-credential'
#
# Verify: `gh api user -q .login` inside the repo must print HowardZlh.

# For direnv users without the zshenv wrapper:
export GH_CONFIG_DIR="$HOME/.config/gh-howardzlh"
